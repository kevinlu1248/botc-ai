    "start:all": "bash scripts/keepup.sh start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
