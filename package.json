{
  "name": "botc-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "dev": "vite --port 5181 --host 127.0.0.1 --strictPort",
    "vision": "vision/.venv/bin/python vision/server.py",
    "up": "bash scripts/keepup.sh start",
