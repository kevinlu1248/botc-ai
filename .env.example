# Copy to .env and fill in.

# Both models: Sonnet 5 (fast/voice) and Fable 5 (background reasoning)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Fable 5 requires 30-day data retention on your org;
# without it, set SLOW_MODEL=claude-opus-5.
# FAST_MODEL=claude-sonnet-5
# SLOW_MODEL=claude-fable-5

# Streaming speech-to-text (Deepgram Nova-3)
DEEPGRAM_API_KEY=

# Transcription accuracy.
# STT_MODEL=nova-3
# Vocabulary to bias decoding toward — jargon, product names, acronyms, names.
# Nova-3 "keyterm prompting": comma-separated, optional :boost per term.
# STT_KEYTERMS=Postgres,DynamoDB,WebSockets,CRDT,Deepgram,ElevenLabs,Anthropic
#
# Browser audio processing (client-side, read at build/dev time). Chrome's noise
# suppression and auto-gain are tuned for phone calls, not recognisers, and can
# cost accuracy — try turning them off if transcription is poor. Do NOT disable
# echo cancellation: barge-in depends on it.
# VITE_MIC_NOISE_SUPPRESSION=false
# VITE_MIC_AGC=false

# Turn detection — how long you may pause before your turn is submitted.
# NOTE: short endpointing fragments your speech into more segments, and each
# segment gives Deepgram's language model less context — so snappier turns cost
# some accuracy. Raise STT_ENDPOINTING_MS if you see errors near pauses.
# Raise these if you get cut off mid-sentence; lower them if it feels sluggish.
# STT_ENDPOINTING_MS=1000         # silence before Deepgram ends the utterance
# STT_UTTERANCE_END_MS=2000       # fallback turn boundary (minimum 1000)
# STT_CONTINUATION_GRACE_MS=2500  # extra wait when speech trails off mid-thought
# STT_IDLE_FLUSH_MS=4000          # backstop if no boundary is reported at all

# Text-to-speech (ElevenLabs Flash v2.5)
ELEVENLABS_API_KEY=
# Optional. Defaults to Sarah (EXAVITQu4vr4xnSDxMaL), a default voice.
# On the free tier, *library* voices (Rachel, Aria, …) return
# 402 "Free users cannot use library voices via the API".
# Known-good free voices: Sarah EXAVITQu4vr4xnSDxMaL,
# George JBFqnCBsd6RMkjVDRZzb, Brian nPczCjzI2devNBz1zQrb
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
